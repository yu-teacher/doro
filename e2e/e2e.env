# E2E 통합 시험의 포트와 로컬 전용 값. 비밀이 아니다(일회용 로컬 스택에서만 쓰는 값). 다른 개발 스택과 겹치지 않는 포트를 쓴다.
E2E_PG_PORT=55432
E2E_AUTH_PORT=58080
E2E_GUARD_HTTP_PORT=58081
E2E_GUARD_GRPC_PORT=59090
E2E_S3_PORT=59000
E2E_PORTAL_PORT=5180
E2E_BLOG_PORT=18090
# 게이트웨이 모드: 브라우저는 이 포트의 nginx 로 접속하고, 로그인·세션은 BFF 가 맡는다(블로그는 Bearer 만 받는다)
E2E_GATEWAY_PORT=18080
E2E_BFF_PORT=18085
# gateway(기본) | embedded(블로그 안의 BFF, 이전 방식). 실행할 때 E2E_BFF_MODE=embedded e2e/run.sh 로 바꾼다.
E2E_BFF_MODE=gateway
E2E_DB_PASSWORD=e2e-only-local-password
# 액세스 토큰 수명을 짧게 해서 "IAM 이 죽은 사이 토큰이 만료되는" 상황을 몇십 초 안에 재현한다
E2E_ACCESS_TOKEN_TTL_SECONDS=20
# 로컬 전용 부트스트랩 토큰(첫 SUPER_ADMIN 을 만드는 데만 쓴다. 32자 이상)
E2E_BOOTSTRAP_TOKEN=e2e-bootstrap-token-local-only-0123456789
# 블로그가 IAM 내부 API(계정 상태 확인)를 부를 때 쓰는 서비스 토큰(로컬 전용 값, 32자 이상)
E2E_INTERNAL_TOKEN=e2e-internal-token-local-only-0123456789abcdef
# BFF 암호화 키(base64 32바이트, 로컬 전용 값). 운영 키가 아니다.
E2E_BFF_SESSION_KEY=ZTJlLW9ubHktbG9jYWwtYmZmLWtleS0wMTIzNDU2Nzg=
# 서비스(도로 파티·도로 게임)가 IAM 내부 API 를 부를 때 쓰는 서비스 토큰(로컬 전용 값, 32자 이상). run-deleted-sync.sh 가 쓴다.
E2E_PARTY_INTERNAL_TOKEN=e2e-party-internal-token-local-only-0123456789
E2E_GAMES_INTERNAL_TOKEN=e2e-games-internal-token-local-only-0123456789
