# 파이의 ~/watchdog/.env 로 복사해서 채운다(권한 600). 비밀 값은 이 예시 파일에 넣지 않는다.
MINI_HOST=192.168.0.101
NOTEBOOK_HOST=192.168.0.4
# 사용자가 접속하는 도메인(게이트웨이의 SNI). 저장소에는 적지 않는다.
PUBLIC_HOST=
LOKI_URL=http://192.168.0.4:3100
# 텔레그램 알림(선택). 비워 두면 알림 없이 기록만 한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 점검·기록은 하되 텔레그램으로는 보내지 않을 점검(공백으로 구분). 보조 서버라서 꺼져도 서비스가 멈추지 않는 것들.
QUIET_CHECKS="notebook_ssh logs_notebook logs_pi"
# 경고 단계(인증서 21일 미만 등)도 알릴지(true/false). false 면 실패 단계만 알린다.
NOTIFY_WARN=false
# 미니 SSH 가 실패한 회차에는 알리지 않을 점검(미니가 죽으면 같이 실패하는 것들). "미니 다운" 한 통만 가게 한다.
MINI_DEPENDENT_CHECKS="web_portal web_blog_api web_party tls_cert"

