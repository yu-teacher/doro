# Loki 앞단. 변수는 컨테이너 환경변수(LOKI_ALLOW_*, LOKI_PUSH_AUTH)로 채워진다.
#
# 접근 정책(허용 목록 방식: 아래에 적지 않은 경로는 전부 403)
#   - 로그 쓰기(push): 허용한 서버 IP + Basic 인증(LOKI_PUSH_AUTH 가 꺼져 있으면 IP 만 검사)
#   - 조회: 허용한 서버 IP 만(포털 로그 화면·watchdog·감사 로그 백업이 쓰는 질의 경로만)
#   - 삭제·flush·설정·링 등 관리용 경로: 누구에게도 열지 않는다. 특히 /loki/api/v1/delete 는 감사 로그를 지울 수 있다.
# 노트북 자신의 수집기는 도커 네트워크로 loki:3100 에 직접 보내므로 이 게이트웨이를 거치지 않는다.
server {
    listen 8080;

    # 자체 점검용: 내용 없이 응답만 확인한다.
    location = /gateway-health {
        access_log off;
        return 200 "ok\n";
    }

    # 로그 쓰기. LOKI_PUSH_AUTH 가 off 면 인증을 건너뛰고, 아니면 그 문구가 인증 영역 이름이 된다.
    # satisfy all: IP 허용과 인증을 모두 통과해야 한다.
    location = /loki/api/v1/push {
        satisfy all;
        allow ${LOKI_ALLOW_1};
        allow ${LOKI_ALLOW_2};
        deny all;
        auth_basic "${LOKI_PUSH_AUTH}";
        auth_basic_user_file /etc/nginx/auth/push.htpasswd;
        client_max_body_size 10m;
        proxy_pass http://loki:3100;
        proxy_set_header Host $host;
    }

    # 조회(질의) 경로만 허용한다.
    location ~ ^/loki/api/v1/(query|query_range|labels|label/[^/]+/values|series|index/stats|index/volume|index/volume_range|detected_fields|detected_labels|patterns)$ {
        allow ${LOKI_ALLOW_1};
        allow ${LOKI_ALLOW_2};
        deny all;
        client_max_body_size 1m;
        proxy_pass http://loki:3100;
        proxy_set_header Host $host;
    }

    # 그 밖의 모든 경로(삭제·flush·설정·링·메트릭 등)는 막는다.
    location / {
        return 403;
    }
}
