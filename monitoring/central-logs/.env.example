# 노트북의 ~/central-logs/.env 로 복사해서 채운다. 이 파일(예시)에는 비밀 값을 넣지 않는다.
# 로그를 보내도 되는 서버 IP(미니, 파이)
LOKI_ALLOW_1=192.168.0.101
LOKI_ALLOW_2=192.168.0.102
# Grafana 관리자 비밀번호: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# --- 알림(선택). 세 값이 모두 있어야 enable-alerting.sh 가 알림을 켠다 ---
# 텔레그램 봇 토큰/chat ID: 이 파일(권한 600)에만 둔다. 채팅이나 저장소에 붙이지 않는다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SSH 로그인 성공을 "정상"으로 보는 접속 IP(정규식, 점은 [.] 로). 맥(36)과 미니의 백업 전송(101)이다. 여기에 없는 IP 에서 로그인되면 알림이 온다.
SSH_ALLOWED_SRC_REGEX='192[.]168[.]0[.](36|101)'

