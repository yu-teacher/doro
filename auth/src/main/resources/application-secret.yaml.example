# [Doro IAM Secret Configuration Example]
# 이 파일을 복사하여 'application-secret.yaml'로 저장하고 실제 운영 비밀값들을 설정하세요.
# 'application-secret.yaml'은 .gitignore에 의해 형상관리(Git)에서 자동 제외됩니다.

spring:
  datasource:
    username: doro_admin
    password: doro_super_secure_secret_password_here
  data:
    redis:
      password: redis_secure_password_here

doro:
  iam:
    jwt:
      # JWT 서명 키쌍(PEM). 코드가 실제로 읽는 속성은 private-key-pem / public-key-pem 이다.
      # 비워 두면 최초 기동 시 RSA-2048 키를 생성해 Redis 에 보관한다. (경로 기반 *-path 속성은 지원하지 않는다)
      private-key-pem: |
        -----BEGIN PRIVATE KEY-----
        (PKCS#8 PEM 본문)
        -----END PRIVATE KEY-----
      public-key-pem: |
        -----BEGIN PUBLIC KEY-----
        (X.509 SubjectPublicKeyInfo PEM 본문)
        -----END PUBLIC KEY-----
      # (선택) Redis 에 보관되는 자동 생성 개인키를 AES-256-GCM 으로 암호화하는 시크릿. env: DORO_IAM_JWT_KEY_ENCRYPTION_SECRET
      # 비워 두면 평문으로 보관되며 기동 시 ERROR 로그가 남는다. 긴 임의 문자열을 사용하고 한 번 정하면 분실하지 말 것.
      redis-key-encryption-secret: change-me-to-a-long-random-secret
      # (선택) 키 로테이션 중 이전 공개키. 새 키의 key-id 와 반드시 달라야 한다. 절차는 application.yaml 주석 참고.
      # env: DORO_IAM_JWT_PREVIOUS_KEY_ID / DORO_IAM_JWT_PREVIOUS_PUBLIC_KEY_PEM
      previous-key-id: doro-iam-key-2026-v1
      previous-public-key-pem: |
        -----BEGIN PUBLIC KEY-----
        (이전 키의 X.509 PEM 본문)
        -----END PUBLIC KEY-----
