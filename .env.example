# PostgreSQL
POSTGRES_DB=doro_iam
POSTGRES_USER=doro_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_PORT=5432
AUTH_DB=doro_auth
GUARD_DB=doro_guard
POSTGRES_MULTIPLE_DATABASES=doro_auth,doro_guard

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# Doro IAM Service
AUTH_PORT=8080
DORO_IAM_ISSUER=https://auth.doro.local

# Doro Guard Service
GUARD_PORT=8081
GUARD_GRPC_PORT=9090

# Doro Web Central Identity Portal
WEB_PORT=3000


# 호스트 바인딩 주소. 내부 서비스는 기본 127.0.0.1, 공개 진입점(auth/web)만 0.0.0.0
# POSTGRES_BIND=127.0.0.1
# REDIS_BIND=127.0.0.1
# GUARD_BIND=127.0.0.1
# AUTH_BIND=127.0.0.1
# WEB_BIND=0.0.0.0

# Guard 서비스 인증 (OFF -> WARN -> ENFORCE). 모든 호출자(auth, 서브 서비스)에 같은 토큰을 배포한 뒤 단계적으로 올린다.
# DORO_GUARD_SECURITY_MODE=OFF
# DORO_GUARD_SERVICE_TOKEN=CHANGE_ME_long_random_token
# 호출자별 토큰을 따로 줄 때 'name:token,...' 형식(선택). IAM 이 Guard 를 부를 때 쓰는 토큰은 DORO_GUARD_AUTH_TOKEN 이 있으면 그것을 우선한다.
# DORO_GUARD_SERVICE_TOKENS=
# DORO_GUARD_AUTH_TOKEN=
# Guard 튜플/스키마 검증 모드(OFF|WARN|ENFORCE), 스키마 갱신 주기(초, 0=끔), 권한 캐시(TTL 초 / 최대 항목 수)
# DORO_GUARD_VALIDATION_MODE=WARN
# DORO_GUARD_SCHEMA_REFRESH_SECONDS=30
# DORO_GUARD_CACHE_TTL_SECONDS=60
# DORO_GUARD_CACHE_MAX_SIZE=50000
# 애플리케이션 로그 레벨(auth/guard 공통)
# DORO_LOG_LEVEL=INFO

# IAM 토큰/CORS (기본값 사용 시 생략 가능)
# 액세스 토큰 수명(초). 로그인 유지는 30일 리프레시 토큰이 담당한다.
# DORO_IAM_ACCESS_TOKEN_TTL_SECONDS=900
# 브라우저에서 IAM 을 직접 호출할 수 있는 Origin 패턴(쉼표 구분)
# DORO_CORS_ALLOWED_ORIGIN_PATTERNS=https://app.example.com,http://localhost:*,http://127.0.0.1:*
# OAuth 인가 코드를 발급할 redirect_uri 허용 목록(쉼표 구분, 정확히 일치). 비어 있으면 OAuth 인가 요청이 모두 거부된다.
# DORO_OAUTH_ALLOWED_REDIRECT_URIS=https://app.example.com/callback
# IP 단위 요청 제한 (로그인 기본 10분당 20회). 끄려면 false
# DORO_IAM_RATE_LIMIT_ENABLED=true
# DORO_IAM_RATE_LIMIT_LOGIN_MAX=20

# --- 서브 서비스 전용 내부 API(/internal/**) 호출자 인증 -----------------------------------------
# 호출자마다 '이름:토큰' (쉼표로 여러 개). 토큰은 32자 이상 무작위: openssl rand -hex 32
# 서비스 쪽에는 같은 토큰을 그 서비스의 환경변수(블로그: DORO_IAM_INTERNAL_TOKEN)로 준다. 토큰은 커밋하지 않는다.
# DORO_IAM_INTERNAL_TOKENS=blog:CHANGE_ME_long_random_token
# 모드: ENFORCE(기본) | WARN(실패를 경고만 하고 통과, 토큰 배포 중) | OFF
# DORO_IAM_INTERNAL_AUTH_MODE=ENFORCE

# --- 세션 ------------------------------------------------------------------------------------------
# 사용자당 동시 활성 세션 총량(포털 + 모든 서비스)
# DORO_IAM_SESSION_MAX_ACTIVE_PER_USER=20
# 한 서비스(OAuth 클라이언트)당 한 사용자의 동시 기기 수. 넘으면 가장 오래 쓰지 않은 세션이 종료된다. 1 이면 서비스당 하나만.
# DORO_IAM_SESSION_MAX_OAUTH_PER_CLIENT=3
# 세션 절대 수명(초). 기본 90일, 0 이하면 끈다.
# DORO_IAM_SESSION_ABSOLUTE_LIFETIME_SECONDS=7776000

# --- 비밀 보관/암호화 ------------------------------------------------------------------------------
# Redis 에 보관하는 JWT 개인키의 at-rest 암호화 시크릿. 비우면 평문 보관(기동 시 경고). 생성: openssl rand -base64 32
# DORO_IAM_JWT_KEY_ENCRYPTION_SECRET=CHANGE_ME_base64_secret
# JWT 키 로테이션 중에만 쓴다: 이전 키의 kid 와 공개키 PEM (이전 토큰이 만료될 때까지 JWKS 에 함께 게시)
# DORO_IAM_JWT_PREVIOUS_KEY_ID=
# DORO_IAM_JWT_PREVIOUS_PUBLIC_KEY_PEM=
# 2FA(TOTP) 시크릿 암호화 키(AES-256-GCM, 32바이트 base64). 생성: openssl rand -base64 32. 비우면 평문 저장(기동 시 경고).
# 한 번 켠 뒤 키를 잃으면 2FA 를 쓸 수 없으니 비밀번호 관리자에 따로 보관한다. 교체 시 이전 키는 PREVIOUS_KEYS(쉼표 구분)에 둔다.
# DORO_IAM_TOTP_ENCRYPTION_KEY=CHANGE_ME_base64_key
# DORO_IAM_TOTP_PREVIOUS_KEYS=

# --- OAuth/OIDC ------------------------------------------------------------------------------------
# 클라이언트 등록 모드: OFF(허용 목록만) | WARN(미등록은 폴백+경고) | ENFORCE(미등록 거부, 기본)
# DORO_OAUTH_CLIENT_REGISTRY_MODE=ENFORCE
# 브라우저 흐름의 동의(로그인) 페이지, 인가 코드 저장소(auto|redis|memory)와 수명(초), 토큰 엔드포인트 IP 단위 요청 제한(10분당)
# DORO_OAUTH_CONSENT_URL=/oauth2/consent
# DORO_OAUTH_CODE_STORE=auto
# DORO_OAUTH_CODE_TTL_SECONDS=300
# DORO_IAM_RATE_LIMIT_TOKEN_MAX=60

# --- 첫 관리자 부트스트랩 ---------------------------------------------------------------------------
# 비워 두면 꺼진다. 32자 이상 난수(openssl rand -hex 32)를 넣고 scripts/bootstrap-first-admin.sh 로 승격한 뒤 반드시 지운다.
# DORO_IAM_BOOTSTRAP_TOKEN=

# --- 계정 탈퇴 / 토큰 정리 -------------------------------------------------------------------------
# 탈퇴 요청 후 복구 가능한 유예 기간(일). 지나면 개인정보를 익명화한다. 정리 작업 주기(밀리초)
# DORO_IAM_ACCOUNT_DELETION_GRACE_DAYS=30
# DORO_IAM_ACCOUNT_DELETION_PURGE_INTERVAL_MS=3600000
# 만료·폐기된 리프레시 토큰과 비활성 세션 정리. 보존 기간(일)은 리프레시 토큰 유효기간(30일)보다 길게 둔다.
# DORO_IAM_TOKEN_PURGE_ENABLED=true
# DORO_IAM_TOKEN_PURGE_RETENTION_DAYS=90

# --- BFF (브라우저 로그인/세션을 서비스 밖에서 처리, docs/BFF.md, scripts/enable-bff.sh) -------------
# 토큰·PKCE verifier 를 DB 에 암호화하는 키. 필수(bff-api 기동 시). 생성: openssl rand -base64 32
# BFF_SESSION_KEY=CHANGE_ME_base64_key
# 탈퇴 동기화용 IAM 내부 API 토큰. IAM 의 DORO_IAM_INTERNAL_TOKENS 에 'bff:<같은 토큰>' 으로 등록한다.
# BFF_IAM_INTERNAL_TOKEN=CHANGE_ME_long_random_token
# 브라우저가 보는 공개 주소(기본: DORO_IAM_ISSUER)
# BFF_PUBLIC_ORIGIN=https://example.com
# BFF_DB=doro_bff
# BFF_PORT=8085

# --- 배포/알림 스크립트 ----------------------------------------------------------------------------
# 서버의 영구 .env 위치(기본 $HOME/doro/.env). 배포 파이프라인과 알림 스크립트가 읽는다.
# DORO_ENV_FILE=/path/to/doro/.env
# 배포·장애 알림(scripts/notify-telegram.sh)용 텔레그램 봇. 비우면 알림을 건너뛴다.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
