# PostgreSQL
POSTGRES_DB=doro_iam
POSTGRES_USER=doro_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_PORT=5432
AUTH_DB=doro_auth
GUARD_DB=doro_guard
POSTGRES_MULTIPLE_DATABASES=doro_auth,doro_guard

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# Doro IAM Service
AUTH_PORT=8080
DORO_IAM_ISSUER=https://auth.doro.local

# Doro Guard Service
GUARD_PORT=8081
GUARD_GRPC_PORT=9090

# Doro Web Central Identity Portal
WEB_PORT=3000


# Observability (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# 호스트 바인딩 주소. 내부 서비스는 기본 127.0.0.1, 공개 진입점(auth/web)만 0.0.0.0
# POSTGRES_BIND=127.0.0.1
# REDIS_BIND=127.0.0.1
# GUARD_BIND=127.0.0.1
# LOKI_BIND=127.0.0.1
# GRAFANA_BIND=127.0.0.1
# AUTH_BIND=0.0.0.0
# WEB_BIND=0.0.0.0

# Guard 서비스 인증 (OFF -> WARN -> ENFORCE). 모든 호출자(auth, 서브 서비스)에 같은 토큰을 배포한 뒤 단계적으로 올린다.
# DORO_GUARD_SECURITY_MODE=OFF
# DORO_GUARD_SERVICE_TOKEN=CHANGE_ME_long_random_token
